{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/gpt-5.6-luna",
  "permission": {
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git stash*": "ask",
      "git branch -D*": "deny",
      "git branch --delete*": "deny",
      "rm *": "ask",
      "mv *": "ask"
    }
  }
}
